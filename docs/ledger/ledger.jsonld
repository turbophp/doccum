      ],
      "size": "M",
      "release": "v1.0.0",
      "dependsOn": [],
      "doneWhen": "A SchemaPortabilityTest runs on all six legs: it computes each index key width against utf8mb4 worst case and asserts it fits InnoDB 3072 and PostgreSQL 2704 or is an explicitly listed driver-conditional expression; it round-trips a maximum-length 4-byte-character value through every indexed varchar, shown failing on pgsql for properties.value_string first; every foreign key column has an index leading with that column; a checked-in inventory names every raw-SQL or collation-dependent site and the test fails when one is not registered; every column compared against user input for equality or uniqueness is listed with its folding rule.",
      "actionStatus": "CompletedActionStatus",
      "startTime": "2026-09-17T11:24:00Z",
      "endTime": "2026-09-17T11:53:08Z",
      "result": [
        "https://github.com/turbophp/doccum/pull/66"
      ]
    },
