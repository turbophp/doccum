      ],
      "size": "S",
      "release": "v1.0.0",
      "dependsOn": [
        "item/schema-query-audit"
      ],
      "doneWhen": "A test inserts a value_string of roughly a thousand multi-byte characters and asserts it round-trips, failing on the PostgreSQL leg first; an index strategy is then chosen with that test green on all three drivers and the reasoning recorded, including which queries the chosen index can and cannot serve.",
      "actionStatus": "CompletedActionStatus",
      "startTime": "2026-09-17T11:55:01Z",
      "endTime": "2026-09-17T12:08:41Z",
      "result": [
        "https://github.com/turbophp/doccum/pull/69"
      ]
    },
