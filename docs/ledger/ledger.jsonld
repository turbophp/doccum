    {
      "@id": "item/spec-section8-reconcile",
      "@type": "Action",
      "order": 54,
      "name": "Section 8 is the authority the rest of the spec now points to, and it still describes Scout",
      "url": "https://github.com/turbophp/doccum/issues/234",
      "isBasedOn": [
