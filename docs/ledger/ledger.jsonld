  "pullRequests": [
    {
      "@id": "https://github.com/turbophp/doccum/pull/2",
      "@type": "PullRequest",
      "identifier": 2,
      "name": "feat: purging, a CI matrix that can prove it, and the v1 ledger",
      "implements": [
        "item/ci-green-baseline",
        "item/purge-commands",
        "item/purge-service"
      ],
      "run": "run/0001",
      "state": "open",
      "dateCreated": "2026-09-16T17:02:30Z",
      "headSha": "7a4b0bb869605230004c6828ec7842f13cfc7640",
      "mergedAt": null,
      "mergeSha": null,
      "mergedIn": null
    }
  ],
  "decisions": [
    {
      "@id": "decision/0001",
      "@type": "Decision",
      "dateCreated": "2026-09-16T17:00:00Z",
      "run": "run/0000",
      "name": "Semantic search is post-v1",
      "rationale": "The spec itself ships keyword search first and describes semantic search as additive. It needs a bundled llama.cpp runtime, sqlite-vec, a PDO connector override and a scheduler authority -- a large item on top of a large item, with nobody asking for it yet. The schema already carries the columns it would need, so deferring costs no rework.",
      "isBasedOn": [
        "spec:8a-semantic-search"
      ],
      "affects": [
        "item/embedding-provider",
        "item/embedding-sweep",
        "item/hybrid-ranking",
        "item/vector-index-seam"
      ],
      "supersedes": null
    },
    {
      "@id": "decision/0002",
      "@type": "Decision",
      "dateCreated": "2026-09-16T17:00:00Z",
      "run": "run/0000",
      "name": "Vision-model OCR is post-v1",
      "rationale": "Optional by design, and it drags in one to two gigabytes of model weights and a hardware-aware picker. Tesseract is the stated default and it works. This lands after the llama.cpp runtime exists for embeddings, so the runtime is paid for once.",
      "isBasedOn": [
        "spec:7a-ocr-providers"
      ],
      "affects": [
        "item/hardware-profile-picker",
        "item/llama-runtime-bundle",
        "item/ocr-provider-seam",
        "item/remote-ocr-providers"
      ],
      "supersedes": null
    },
    {
      "@id": "decision/0003",
      "@type": "Decision",
      "dateCreated": "2026-09-16T17:00:00Z",
      "run": "run/0000",
      "name": "PostgreSQL ships with unranked search in v1",
      "rationale": "FTS5 gives SQLite ranked BM25 results; other drivers fall back to a correct-but-unranked LIKE. A ranked tsvector index is a second search implementation to maintain and test, and SQLite is the default everyone runs. v1 documents the limitation instead of hiding it.",
      "isBasedOn": [
        "spec:8-search"
      ],
      "affects": [
        "item/tsvector-index"
      ],
      "supersedes": null
    },
    {
      "@id": "decision/0004",
      "@type": "Decision",
      "dateCreated": "2026-09-16T17:00:00Z",
      "run": "run/0000",
      "name": "Legal hold is file-level only in v1",
      "rationale": "Only files carry the column, and a single held file already blocks its whole period from purging -- which is the guard that matters. A subtree-wide hold is a second inheritance model to reason about for no additional protection.",
      "isBasedOn": [
        "spec:9-archive-and-purge"
      ],
      "affects": [
        "item/directory-legal-hold"
      ],
      "supersedes": null
    }
  ]
}
