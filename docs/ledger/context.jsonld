{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://github.com/turbophp/doccum/tree/main/docs/ledger/vocab#",
    "@base": "https://github.com/turbophp/doccum/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "spec": "https://github.com/turbophp/doccum/blob/main/docs/superpowers/specs/2026-09-15-doccum-design.md#",

    "Action": "schema:Action",
    "SoftwareApplication": "schema:SoftwareApplication",
    "name": "schema:name",
    "description": "schema:description",
    "identifier": "schema:identifier",
    "version": "schema:version",
    "url": { "@id": "schema:url", "@type": "@id" },
    "about": { "@id": "schema:about", "@type": "@id" },
    "agent": { "@id": "schema:agent", "@type": "@id" },
    "isBasedOn": { "@id": "schema:isBasedOn", "@type": "@id", "@container": "@set" },
    "result": { "@id": "schema:result", "@type": "@id", "@container": "@set" },
    "dateCreated": { "@id": "schema:dateCreated", "@type": "xsd:dateTime" },
    "dateModified": { "@id": "schema:dateModified", "@type": "xsd:dateTime" },
    "startTime": { "@id": "schema:startTime", "@type": "xsd:dateTime" },
    "endTime": { "@id": "schema:endTime", "@type": "xsd:dateTime" },
    "actionStatus": { "@id": "schema:actionStatus", "@type": "@vocab" },
    "PotentialActionStatus": "schema:PotentialActionStatus",
    "ActiveActionStatus": "schema:ActiveActionStatus",
    "CompletedActionStatus": "schema:CompletedActionStatus",
    "FailedActionStatus": "schema:FailedActionStatus",

    "Ledger": "Ledger",
    "Run": "Run",
    "PullRequest": "PullRequest",
    "Decision": "Decision",
    "Mutation": "Mutation",

    "items": { "@id": "items", "@container": "@list" },
    "pullRequests": { "@id": "pullRequests", "@container": "@list" },
    "decisions": { "@id": "decisions", "@container": "@list" },
    "mutations": { "@id": "mutations", "@container": "@list" },
    "latestRun": { "@id": "latestRun", "@type": "@id" },
    "order": { "@id": "order", "@type": "xsd:integer" },
    "size": "size",
    "release": "release",
    "doneWhen": "doneWhen",
    "dependsOn": { "@id": "dependsOn", "@type": "@id", "@container": "@set" },
    "touched": { "@id": "touched", "@type": "@id", "@container": "@set" },
    "implements": { "@id": "implements", "@type": "@id", "@container": "@set" },
    "affects": { "@id": "affects", "@type": "@id", "@container": "@set" },
    "supersedes": { "@id": "supersedes", "@type": "@id" },
    "run": { "@id": "run", "@type": "@id" },
    "mergedIn": { "@id": "mergedIn", "@type": "@id" },
    "rationale": "rationale",
    "state": "state",
    "mergedAt": { "@id": "mergedAt", "@type": "xsd:dateTime" },
    "headSha": "headSha",
    "mergeSha": "mergeSha",
    "commit": "commit",
    "tests": { "@id": "tests", "@type": "xsd:integer" },
    "assertions": { "@id": "assertions", "@type": "xsd:integer" },
    "outcome": "outcome",

    "pullRequest": { "@id": "pullRequest", "@type": "@id" },
    "mutant": "mutant",
    "check": "check",
    "verdict": "verdict",
    "evidence": { "@id": "evidence", "@type": "@id", "@container": "@set" },

    "merges": { "@id": "merges", "@container": "@list" },
    "testsRun": { "@id": "testsRun", "@type": "@id" },
    "testsConclusion": "testsConclusion",
    "ledgerRun": { "@id": "ledgerRun", "@type": "@id" },
    "ledgerConclusion": "ledgerConclusion"
  }
}
