APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Reverse proxy. Left unset, doccum trusts X-Forwarded-Proto/-Host/-For/-Port
# only from private/loopback addresses (bootstrap/app.php) -- enough for a
# proxy on the same Docker network or on the host's own loopback, which is
# how this container is meant to be run. Set to "*" to trust every connecting
# address (only if something in front already strips or sets these headers
# itself, e.g. a cloud load balancer), to a comma-separated list of IPs/CIDRs
# to trust exactly those, or to an empty string to trust none.
# TRUSTED_PROXIES=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Storage — local MinIO by default. Point these at S3 or a remote MinIO to
# detach storage from the compose stack; no code change is required.
FILESYSTEM_DISK=documents
AWS_ACCESS_KEY_ID=doccum
# Match whatever MINIO_ROOT_PASSWORD you set for compose.yaml's storage
# profile -- there is no default there any more, so there is none here.
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=doccum
AWS_ENDPOINT=http://minio:9000

DOCCUM_VERSION=0.1.0-dev
